# Paste the token from @BotFather here. Never upload your real .env to GitHub.
BOT_TOKEN=

# Your numeric Telegram user ID. This project defaults to 6195715245 if left blank.
# Multiple owners: 6195715245,987654321. Only owners can grant the Bot Admin role.
OWNER_IDS=6195715245

# Persistent SQLite location. On Render, use /var/data/id_inactive_deleted.sqlite3 with a persistent disk.
DB_PATH=data/id_inactive_deleted.sqlite3

# Initial defaults used only when the SQLite settings are first created.
# New groups use these defaults. Change them per group using /setinactive and /setwarning in that GC (not in private chat).
ACTIVITY_DAYS=13
WARNING_HOURS=24

# How often to check warnings and deadlines.
CHECK_INTERVAL_MINUTES=60
LOG_LEVEL=INFO
